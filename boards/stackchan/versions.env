# Candidate pins; compatibility must pass CI before being considered verified.
ESP32_VERSION=4.0.0
M5UNIFIED_VERSION=0.2.20
# M5Unified 0.2.20 references board IDs added through M5GFX 0.2.26.
M5GFX_VERSION=0.2.26
# K151 IDF 6.1.1 SPI DMA compatibility patch: tools/patch_stackchan_m5gfx.py.
# Only the official PY32 RGB driver is staged; full begin() is not used.
STACKCHAN_BSP_VERSION=1.1.0
STACKCHAN_BSP_COMMIT=f7ed40e6f5d9a1d08440cb926f3a0865b81882f8

ARDUINO_GFX_VERSION=1.6.9
# StackChan only: upstream Arduino 4 GPIO/Print and ESP-IDF 6 SPI compatibility fix (#825).
STACKCHAN_GFX_COMMIT=a78b375753d8700a5abb46fe04f9125af9890127
# Published Arduino Library Manager release; retain Japanese and Korean Unifont.
U8G2_VERSION=2.36.19

